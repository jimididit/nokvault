---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { SITE } from '../../data/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<DocsLayout
  title="Changelog - NokVault"
  description="NokVault release history pointers and upgrade guidance."
  canonical={`${base}docs/changelog`}
>
  <h1>Changelog</h1>
  <p class="lede">
    Notable changes are published with each release. For full notes, visit
    <a href={SITE.releases} target="_blank" rel="noopener noreferrer">GitHub Releases</a>.
  </p>

  <section aria-labelledby="current-version">
    <h2 id="current-version">Current version</h2>
    <p>
      The latest documented release on this site is <code>v{SITE.version}</code>. Verify an installed binary with
      <code>nokvault --version</code>, or visit the
      <a href={SITE.releases} target="_blank" rel="noopener noreferrer">GitHub Releases page</a>.
    </p>
  </section>

  <section aria-labelledby="version-history">
    <h2 id="version-history">Version history</h2>
    <p>
      Detailed release notes live on GitHub:
      <a href={SITE.releases} target="_blank" rel="noopener noreferrer">View all releases →</a>
    </p>
  </section>

  <section aria-labelledby="upgrading">
    <h2 id="upgrading">Upgrading</h2>
    <p>To upgrade {SITE.name}:</p>
    <ol>
      <li>
        Download the latest binary from
        <a href={SITE.releases} target="_blank" rel="noopener noreferrer">GitHub Releases</a>
      </li>
      <li>Replace your existing binary (or update via Homebrew/Scoop)</li>
      <li>Verify the installation: <code>nokvault --version</code></li>
    </ol>
    <p>
      <strong>Note:</strong> Encrypted files remain readable across compatible releases. Files encrypted with older versions
      can be decrypted with newer versions that still support that format.
    </p>
  </section>
</DocsLayout>
