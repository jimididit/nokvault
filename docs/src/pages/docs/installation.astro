---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { SITE } from '../../data/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<DocsLayout
  title="Installation Guide - NokVault"
  description="Install a verified NokVault binary with Homebrew, Scoop, GitHub Releases, or build from source."
  canonical={`${base}docs/installation`}
  keywords={['nokvault install', 'install nokvault', 'nokvault download', 'CLI encryption install', 'encryption tool setup']}
>
  <h1>Installation</h1>
  <p class="lede">
    Install {SITE.name} with a package manager, an attested release binary, or a local Go build. Prefer verified releases for production use.
  </p>

  <section aria-labelledby="homebrew">
    <h2 id="homebrew">Homebrew</h2>
    <p>On macOS, install the hash-pinned formula from the {SITE.name} tap:</p>
    <CodeBlock
      code={`brew tap jimididit/nokvault https://github.com/jimididit/nokvault.git
brew install jimididit/nokvault/nokvault`}
      lang="bash"
      filename="homebrew"
    />
  </section>

  <section aria-labelledby="scoop">
    <h2 id="scoop">Scoop</h2>
    <p>On Windows, install the hash-pinned Scoop manifest directly from the repository:</p>
    <CodeBlock
      code={`scoop install https://raw.githubusercontent.com/jimididit/nokvault/main/scoop/nokvault.json`}
      lang="bash"
      filename="scoop"
    />
  </section>

  <section aria-labelledby="release-binaries">
    <h2 id="release-binaries">Release binaries</h2>
    <p>
      Download a pre-built binary for Windows, Linux, or macOS from
      <a href={SITE.releases} target="_blank" rel="noopener noreferrer">GitHub Releases</a>.
    </p>
    <ol>
      <li>Choose the artifact for your platform and architecture.</li>
      <li>On Linux and macOS, make it executable: <code>chmod +x nokvault</code>.</li>
      <li>Move it into a directory on your <code>PATH</code>, or run it from the download location.</li>
    </ol>

    <h3>Verify release provenance</h3>
    <p>
      Releases published after provenance support was enabled include SHA-256 checksums and a GitHub build attestation.
      Compare the downloaded binary with <code>checksums.txt</code>, then verify that GitHub Actions built it from this repository:
    </p>
    <CodeBlock
      code="gh attestation verify ./nokvault-linux-amd64 --repo jimididit/nokvault"
      lang="bash"
      filename="attestation"
    />
    <p>
      Replace the filename with the artifact for your platform. The command requires the GitHub CLI and an internet connection.
    </p>
    <p>
      An APT repository is not currently published. Linux users should download the attested binary for their architecture from
      <a href={SITE.releases} target="_blank" rel="noopener noreferrer">GitHub Releases</a>.
    </p>
  </section>

  <section aria-labelledby="build-from-source">
    <h2 id="build-from-source">Build from source</h2>
    <p>Build {SITE.name} from source when you need the latest tip or a customized build.</p>

    <h3>Prerequisites</h3>
    <ul>
      <li>Go 1.25.11 or later</li>
      <li>Git</li>
    </ul>

    <h3>Build steps</h3>
    <CodeBlock
      code={`git clone https://github.com/jimididit/nokvault.git
cd nokvault

# Windows
go build -o nokvault.exe ./cmd/nokvault

# Linux/macOS
go build -o nokvault ./cmd/nokvault`}
      lang="bash"
      filename="build"
    />
    <p>The binary is created in the current directory. Move it onto your <code>PATH</code> for system-wide use.</p>

    <h3>Cross-compilation</h3>
    <p>Build binaries for other platforms from your current machine:</p>
    <CodeBlock
      code={`# Windows (64-bit)
GOOS=windows GOARCH=amd64 go build -o nokvault-windows-amd64.exe ./cmd/nokvault

# Linux (64-bit)
GOOS=linux GOARCH=amd64 go build -o nokvault-linux-amd64 ./cmd/nokvault

# macOS (Intel)
GOOS=darwin GOARCH=amd64 go build -o nokvault-darwin-amd64 ./cmd/nokvault

# macOS (Apple Silicon)
GOOS=darwin GOARCH=arm64 go build -o nokvault-darwin-arm64 ./cmd/nokvault`}
      lang="bash"
      filename="cross-compile"
    />
  </section>

  <section aria-labelledby="verify-installation">
    <h2 id="verify-installation">Verify installation</h2>
    <p>Confirm the binary runs:</p>
    <CodeBlock code="nokvault --version" lang="bash" />
    <p>
      You should see the version number. If the shell reports “command not found,” ensure the binary is on your <code>PATH</code>.
    </p>
  </section>
</DocsLayout>
