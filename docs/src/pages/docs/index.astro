---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { DOCS_PAGES, SITE } from '../../data/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const startHere = DOCS_PAGES.filter((page) => page.group === 'Start');
const commonWorkflows = DOCS_PAGES.filter((page) =>
  page.group === 'Core Operations' || page.group === 'Reference' || page.group === 'Project',
);
const securityModel = DOCS_PAGES.filter((page) => page.group === 'Security');

function hrefFor(pageHref: string) {
  const path = pageHref.startsWith('/') ? pageHref.slice(1) : pageHref;
  return `${base}${path}`;
}
---

<DocsLayout
  title="Documentation Overview - NokVault"
  description="Choose the shortest path from installation to a verified recovery with NokVault documentation."
  canonical={`${base}docs/`}
  keywords={['nokvault documentation', 'encryption guide', 'CLI encryption tutorial', 'file encryption how-to']}
>
  <h1>Documentation</h1>
  <p class="lede">
    Pick a path into {SITE.name}: install and verify recovery, run core operations, or understand the security model before you automate.
  </p>

  <section aria-labelledby="start-here">
    <h2 id="start-here">Start Here</h2>
    <p>Get a verified binary or source build, then encrypt and decrypt a file you can recover.</p>
    <ul class="docs-path-list">
      {
        startHere.map((page) => (
          <li>
            <a href={hrefFor(page.href)}>{page.title}</a>
            <p>{page.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="common-workflows">
    <h2 id="common-workflows">Common Workflows</h2>
    <p>Command reference, automation patterns, configuration, and project references.</p>
    <ul class="docs-path-list">
      {
        commonWorkflows.map((page) => (
          <li>
            <a href={hrefFor(page.href)}>{page.title}</a>
            <p>{page.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="security-model">
    <h2 id="security-model">Understand the Security Model</h2>
    <p>Read the mechanisms, safeguards, and limitations before you rely on encrypted archives or secure-delete.</p>
    <ul class="docs-path-list">
      {
        securityModel.map((page) => (
          <li>
            <a href={hrefFor(page.href)}>{page.title}</a>
            <p>{page.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</DocsLayout>
