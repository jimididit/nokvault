---
import BeginnerPath from '../components/BeginnerPath.astro';
import InstallSelector from '../components/InstallSelector.astro';
import Layout from '../layouts/Layout.astro';
import SecurityPosture from '../components/SecurityPosture.astro';
import StructuredData from '../components/StructuredData.astro';
import TerminalDemo from '../components/TerminalDemo.astro';
import TrustRail from '../components/TrustRail.astro';
import WorkflowCapabilities from '../components/WorkflowCapabilities.astro';
import { SITE } from '../data/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout
  title="NokVault - Encrypt and Protect Your Files | CLI Encryption Tool"
  description="NokVault is a modern, cross-platform CLI tool for encrypting files and directories using AES-256-GCM encryption. Protect your sensitive data with strong encryption, automatic file watching, and secure key management."
  canonical={base}
  keywords={['file encryption', 'CLI encryption', 'AES-256', 'directory encryption', 'secure files', 'privacy tool', 'encryption software', 'command line encryption']}
  bodyClass="landing-page"
>
  <StructuredData
    type="SoftwareApplication"
    data={{
      name: SITE.name,
      description: 'A modern CLI tool for encrypting local files and folders',
      version: SITE.version,
      downloadUrl: SITE.releases,
    }}
  />

  <div class="landing">
    <section class="landing-hero container" aria-labelledby="landing-hero-heading">
      <div class="landing-hero__copy">
        <p class="eyebrow landing-hero__reveal">Local encryption / deliberately private</p>
        <h1 id="landing-hero-heading" class="landing-hero__reveal landing-hero__reveal--delay-1">
          Your files.<br /><span>Your keys.</span><br />Your control.
        </h1>
        <p class="landing-hero__lede landing-hero__reveal landing-hero__reveal--delay-2">
          Strong local encryption without surrendering your data, workflow, or judgment to a cloud service.
        </p>
        <div class="landing-hero__actions landing-hero__reveal landing-hero__reveal--delay-3">
          <a class="button button--primary" href={`${base}docs/installation`}>Install NokVault</a>
          <a class="button button--secondary" href={`${base}docs/`}>Read the docs</a>
        </div>
      </div>
      <div class="landing-hero__terminal landing-hero__reveal landing-hero__reveal--delay-4">
        <TerminalDemo />
      </div>
    </section>

    <div class="container">
      <TrustRail />
    </div>

    <div class="landing-section container">
      <BeginnerPath />
    </div>

    <hr class="structural-rule container" />

    <div class="landing-section container">
      <WorkflowCapabilities />
    </div>

    <hr class="structural-rule container" />

    <div class="landing-section container">
      <SecurityPosture />
    </div>

    <hr class="structural-rule container" />

    <div class="landing-section container landing-section--final">
      <InstallSelector />
    </div>
  </div>
</Layout>

<style>
  .landing {
    padding-block: 0 80px;
    overflow-x: clip;
  }

  .landing-hero {
    position: relative;
    display: grid;
    gap: 40px;
    padding-block: 48px 56px;
  }

  .landing-hero::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    z-index: -1;
    width: min(72vw, 720px);
    height: min(52vw, 420px);
    background:
      radial-gradient(ellipse at 20% 20%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 62%);
    pointer-events: none;
  }

  .landing-hero__copy {
    max-width: 34rem;
  }

  .landing-hero h1 {
    margin-bottom: 20px;
    max-width: 11ch;
  }

  .landing-hero h1 span {
    color: var(--accent);
  }

  .landing-hero__lede {
    margin-bottom: 28px;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.55;
  }

  .landing-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .landing-hero__actions .button {
    min-height: 44px;
  }

  .landing-hero__terminal {
    min-width: 0;
  }

  .landing-section {
    padding-block: 56px;
  }

  .landing-section--final {
    padding-bottom: 24px;
  }

  .landing-hero__reveal {
    animation: landing-hero-in 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .landing-hero__reveal--delay-1 {
    animation-delay: 40ms;
  }

  .landing-hero__reveal--delay-2 {
    animation-delay: 80ms;
  }

  .landing-hero__reveal--delay-3 {
    animation-delay: 120ms;
  }

  .landing-hero__reveal--delay-4 {
    animation-delay: 160ms;
  }

  @keyframes landing-hero-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 1024px) {
    .landing-hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: end;
      gap: 64px;
      padding-block: 72px 80px;
    }

    .landing-section {
      padding-block: 72px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .landing-hero__reveal,
    .landing-hero__reveal--delay-1,
    .landing-hero__reveal--delay-2,
    .landing-hero__reveal--delay-3,
    .landing-hero__reveal--delay-4 {
      animation: none;
    }
  }
</style>
