---
import ArticleNavigation from '../components/ArticleNavigation.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DocsSearch from '../components/DocsSearch.astro';
import SEO from '../components/SEO.astro';
import Sidebar from '../components/Sidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StructuredData from '../components/StructuredData.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { getDocPage, headingId, SITE } from '../data/site';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  keywords?: string[];
  breadcrumbs?: Array<{ name: string; url: string }>;
  toc?: Array<{ label: string; href: string; depth?: 2 | 3 }>;
}

const {
  title,
  description = `${SITE.name} Documentation`,
  canonical,
  keywords,
  breadcrumbs,
  toc,
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const page = getDocPage(Astro.url.pathname);
const crumbTitle = page?.title ?? title.replace(/\s*-\s*Nokvault$/i, '').replace(/\s*-\s*NokVault$/i, '');
const docsIndexPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isDocsIndex = docsIndexPath === '/docs' || docsIndexPath.endsWith('/docs');

const defaultBreadcrumbs = breadcrumbs || [
  { name: 'Home', url: base },
  { name: 'Documentation', url: `${base}docs/` },
  ...(isDocsIndex ? [] : [{ name: crumbTitle, url: Astro.url.pathname }]),
];

const resolvedToc =
  toc ??
  (page?.headings || []).map((heading) => ({
    label: heading,
    href: `#${headingId(heading)}`,
    depth: 2 as const,
  }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        const key = 'nokvault-theme';
        let preference = 'system';
        try {
          const saved = localStorage.getItem(key);
          if (saved === 'light' || saved === 'dark' || saved === 'system') preference = saved;
        } catch {}
        const resolved = preference === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : preference;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = resolved;
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <SEO title={title} description={description} canonical={canonical} keywords={keywords} />
    <StructuredData type="BreadcrumbList" breadcrumbs={defaultBreadcrumbs} />
    <StructuredData type="WebSite" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <div class="docs-shell">
      <div class="docs-shell__sidebar">
        <Sidebar />
      </div>
      <div class="docs-shell__content">
        <DocsSearch />
        <main id="main-content" class="docs-article" tabindex="-1">
          <Breadcrumbs items={defaultBreadcrumbs} />
          <div class="docs-article__body">
            <slot />
          </div>
          <ArticleNavigation />
        </main>
      </div>
      <aside class="docs-shell__toc" aria-label="Page outline">
        <TableOfContents entries={resolvedToc} />
      </aside>
    </div>
    <SiteFooter />
  </body>
</html>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    width: min(calc(100% - 32px), var(--content-wide));
    margin-inline: auto;
    padding-block: 24px 64px;
  }

  .docs-shell__toc {
    display: none;
  }

  .docs-article {
    width: 100%;
    max-width: var(--content-prose);
  }

  .docs-article__body {
    overflow-x: auto;
  }

  .docs-article__body :global(h1) {
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .docs-article__body :global(h2) {
    margin-top: 2rem;
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
  }

  .docs-article__body :global(h3) {
    margin-top: 1.5rem;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
  }

  .docs-article__body :global(.lede) {
    color: var(--text-muted);
    font-size: 1.125rem;
  }

  .docs-article__body :global(.docs-path-list) {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .docs-article__body :global(.docs-path-list li) {
    border-bottom: 1px solid var(--border);
    padding: 16px 0;
  }

  .docs-article__body :global(.docs-path-list a) {
    font-weight: 600;
    text-decoration: none;
  }

  .docs-article__body :global(.docs-path-list p) {
    margin: 8px 0 0;
    color: var(--text-muted);
  }

  .docs-article__body :global(table),
  .docs-article__body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
  }

  @media (min-width: 768px) {
    .docs-shell {
      width: min(calc(100% - 64px), var(--content-wide));
      padding-block: 40px 80px;
    }
  }

  @media (min-width: 1024px) {
    .docs-shell {
      grid-template-columns: minmax(200px, 240px) minmax(0, 1fr);
      gap: 48px;
      align-items: start;
    }

    .docs-shell__sidebar :global(.mobile-docs-nav) {
      display: none;
    }
  }

  @media (min-width: 1200px) {
    .docs-shell {
      grid-template-columns: minmax(200px, 240px) minmax(0, 1fr) minmax(160px, 220px);
    }

    .docs-shell__toc {
      display: block;
    }
  }
</style>
