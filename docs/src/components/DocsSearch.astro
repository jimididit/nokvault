---
import { DOCS_PAGES } from '../data/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const docsHref = `${base}docs/`;
const searchPages = DOCS_PAGES.map((page) => ({
  group: page.group,
  title: page.title,
  href: page.href,
  description: page.description,
  headings: [...page.headings],
}));
---

<div class="docs-search" data-docs-search data-docs-base={base}>
  <a class="docs-search__trigger button button--secondary" href={docsHref} data-docs-search-trigger>
    Search documentation
  </a>

  <dialog class="docs-search__dialog" data-docs-search-dialog aria-labelledby="docs-search-title">
    <form method="dialog" class="docs-search__close-row">
      <button type="submit" class="button button--secondary" value="close">Close</button>
    </form>
    <h2 id="docs-search-title" class="docs-search__title">Search documentation</h2>
    <label for="docs-search-input">Search documentation</label>
    <input id="docs-search-input" type="search" autocomplete="off" data-docs-search-input />
    <p id="docs-search-status" role="status" aria-live="polite" data-docs-search-status></p>
    <ul id="docs-search-results" data-docs-search-results></ul>
  </dialog>

  <script is:inline type="application/json" id="docs-search-data" set:html={JSON.stringify(searchPages)} />
</div>

<style>
  .docs-search {
    margin-bottom: 24px;
  }

  .docs-search__trigger {
    width: 100%;
    justify-content: flex-start;
  }

  .docs-search__dialog {
    width: min(100% - 32px, 560px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    padding: 24px;
  }

  .docs-search__dialog::backdrop {
    background: color-mix(in srgb, var(--canvas) 40%, #000 35%);
  }

  .docs-search__close-row {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 12px;
  }

  .docs-search__title {
    margin: 0 0 16px;
    font-size: 1.25rem;
  }

  .docs-search label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
  }

  .docs-search input[type='search'] {
    width: 100%;
    min-height: 44px;
    margin-bottom: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--canvas);
    color: var(--text);
    padding: 8px 12px;
    font: inherit;
  }

  #docs-search-status {
    min-height: 1.5em;
    margin: 0 0 12px;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  #docs-search-results {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: min(50vh, 360px);
    overflow: auto;
  }

  #docs-search-results a {
    display: block;
    min-height: 44px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text);
  }

  #docs-search-results a[aria-selected='true'],
  #docs-search-results a:hover {
    background: var(--surface-raised);
  }

  #docs-search-results .docs-search__meta {
    display: block;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
</style>

<script>
  import { rankDocsSearch } from '../lib/docs-search.mjs';

  type SearchPage = {
    group: string;
    title: string;
    href: string;
    description: string;
    headings: string[];
  };

  const root = document.querySelector('[data-docs-search]');
  if (root instanceof HTMLElement) {
    const trigger = root.querySelector('[data-docs-search-trigger]');
    const dialog = root.querySelector('[data-docs-search-dialog]');
    const input = root.querySelector('[data-docs-search-input]');
    const status = root.querySelector('[data-docs-search-status]');
    const results = root.querySelector('[data-docs-search-results]');
    const dataNode = root.querySelector('#docs-search-data');
    const siteBase = root.getAttribute('data-docs-base') || '/';

    let pages: SearchPage[] = [];
    try {
      pages = dataNode ? (JSON.parse(dataNode.textContent || '[]') as SearchPage[]) : [];
    } catch {
      pages = [];
    }

    if (
      trigger instanceof HTMLAnchorElement &&
      dialog instanceof HTMLDialogElement &&
      input instanceof HTMLInputElement &&
      status instanceof HTMLElement &&
      results instanceof HTMLElement
    ) {
      let activeIndex = -1;

      const withBase = (href: string) => {
        if (/^https?:\/\//i.test(href)) return href;
        return `${siteBase}${href.replace(/^\//, '')}`;
      };

      const setActive = (index: number) => {
        const links = Array.from(results.querySelectorAll('a'));
        activeIndex = index;
        links.forEach((link, i) => {
          link.setAttribute('aria-selected', i === activeIndex ? 'true' : 'false');
        });
        links[activeIndex]?.scrollIntoView({ block: 'nearest' });
      };

      const render = (query: string) => {
        const ranked = rankDocsSearch(pages, query);
        results.replaceChildren();
        activeIndex = ranked.length > 0 ? 0 : -1;

        if (!query.trim()) {
          status.textContent = '';
          return;
        }

        status.textContent =
          ranked.length === 0
            ? 'No matching documentation pages.'
            : `${ranked.length} result${ranked.length === 1 ? '' : 's'}`;

        for (const [index, page] of ranked.entries()) {
          const item = document.createElement('li');
          const link = document.createElement('a');
          const title = document.createElement('strong');
          const meta = document.createElement('span');
          title.textContent = page.title;
          meta.className = 'docs-search__meta';
          meta.textContent = `${page.group} · ${page.description}`;
          link.href = withBase(page.href);
          link.setAttribute('aria-selected', index === 0 ? 'true' : 'false');
          link.append(title, meta);
          item.append(link);
          results.append(item);
        }
      };

      const open = (query = '') => {
        if (!dialog.open) dialog.showModal();
        input.value = query;
        render(query);
        queueMicrotask(() => {
          input.focus();
          input.select();
        });
      };

      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        open();
      });

      input.addEventListener('input', () => {
        render(input.value);
      });

      input.addEventListener('keydown', (event) => {
        const links = Array.from(results.querySelectorAll('a'));
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          if (links.length === 0) return;
          setActive((activeIndex + 1) % links.length);
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          if (links.length === 0) return;
          setActive((activeIndex - 1 + links.length) % links.length);
        } else if (event.key === 'Enter') {
          if (activeIndex >= 0 && links[activeIndex]) {
            event.preventDefault();
            links[activeIndex].click();
          }
        } else if (event.key === 'Escape') {
          event.preventDefault();
          dialog.close();
        }
      });

      dialog.addEventListener('close', () => {
        status.textContent = '';
        results.replaceChildren();
        activeIndex = -1;
      });

      const params = new URLSearchParams(window.location.search);
      const initialQuery = params.get('q');
      if (initialQuery) {
        open(initialQuery);
      }
    }
  }
</script>
