---
import { SITE } from '../data/site';
import ThemeControl from './ThemeControl.astro';
import Wordmark from './Wordmark.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<header class="site-header">
  <div class="site-header__inner">
    <Wordmark />
    <nav class="site-header__nav" aria-label="Primary navigation">
      <a href={`${base}docs/`}>Documentation</a>
      <a href={`${base}docs/security`}>Security</a>
      <a href={SITE.repository} target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
    <div class="site-header__actions">
      <ThemeControl />
      <a class="button button--primary site-header__install" href={`${base}docs/installation`}>
        Install NokVault
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--canvas) 92%, transparent);
    backdrop-filter: blur(12px);
  }

  .site-header__inner {
    display: flex;
    min-height: var(--header-height);
    align-items: center;
    gap: 24px;
    width: min(calc(100% - 32px), var(--content-wide));
    margin-inline: auto;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-inline-start: auto;
  }

  .site-header__nav a {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-header__nav a:hover {
    color: var(--text);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  @media (min-width: 768px) {
    .site-header__inner {
      width: min(calc(100% - 64px), var(--content-wide));
    }
  }

  @media (max-width: 900px) {
    .site-header__inner {
      flex-wrap: wrap;
      padding-block: 12px;
    }

    .site-header__nav {
      order: 3;
      width: 100%;
      justify-content: center;
    }

    .site-header__actions {
      margin-inline-start: auto;
    }
  }

  @media (max-width: 560px) {
    .site-header__install {
      display: none;
    }
  }
</style>
