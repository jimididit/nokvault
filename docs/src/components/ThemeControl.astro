<button
  type="button"
  class="theme-control"
  data-theme-control
  aria-label="Switch to dark theme"
>
  <span class="theme-control__icons" aria-hidden="true">
    <svg class="theme-control__icon theme-control__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
    <svg class="theme-control__icon theme-control__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z"></path>
    </svg>
  </span>
</button>

<script>
  const storageKey = 'nokvault-theme';
  const control = document.querySelector<HTMLButtonElement>('[data-theme-control]');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const resolveTheme = (preference: string) =>
    preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;

  const syncControl = () => {
    if (!control) return;
    const resolved = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    control.setAttribute(
      'aria-label',
      resolved === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
    );
    control.dataset.resolved = resolved;
  };

  const applyTheme = (preference: string, persist = false) => {
    document.documentElement.dataset.themePreference = preference;
    document.documentElement.dataset.theme = resolveTheme(preference);
    syncControl();

    if (persist) {
      try {
        localStorage.setItem(storageKey, preference);
      } catch {}
    }
  };

  applyTheme(document.documentElement.dataset.themePreference ?? 'system');

  control?.addEventListener('click', () => {
    const resolved = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    applyTheme(resolved === 'dark' ? 'light' : 'dark', true);
  });

  media.addEventListener('change', () => {
    if (document.documentElement.dataset.themePreference === 'system') {
      applyTheme('system');
    }
  });
</script>

<style>
  .theme-control {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .theme-control:hover {
    background: var(--surface-raised);
  }

  .theme-control:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .theme-control__icons {
    position: relative;
    width: 20px;
    height: 20px;
  }

  .theme-control__icon {
    position: absolute;
    inset: 0;
    width: 20px;
    height: 20px;
    transition:
      opacity 220ms ease,
      transform 220ms ease;
  }

  :global([data-theme='light']) .theme-control__icon--sun,
  :global(:root:not([data-theme='dark'])) .theme-control__icon--sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.55);
  }

  :global([data-theme='light']) .theme-control__icon--moon,
  :global(:root:not([data-theme='dark'])) .theme-control__icon--moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global([data-theme='dark']) .theme-control__icon--sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global([data-theme='dark']) .theme-control__icon--moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.55);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-control__icon {
      transition: none;
    }
  }
</style>
