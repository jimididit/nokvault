---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const columns = [
  {
    title: 'Mechanisms',
    items: [
      'AES-256-GCM authenticated encryption',
      'Argon2id password-based key derivation with per-file salts',
      'Cryptographically secure IVs; authenticity via AES-GCM tag verification',
    ],
  },
  {
    title: 'Safeguards',
    items: [
      'Default-deny symlink and reparse-point path policy',
      'Overwrite refusal, confirmation gates, and strict abort modes',
      'Directory output containment before prompts or writes',
    ],
  },
  {
    title: 'Boundaries',
    items: [
      'Best-effort secure delete on SSD, COW, and snapshot storage',
      'Best-effort memory zeroization against swap and memory dumps',
      'Path-validation race against a privileged local attacker is a non-goal',
    ],
  },
] as const;
---

<section class="security-posture" aria-labelledby="security-posture-heading">
  <div class="security-posture__intro">
    <p class="eyebrow">Security posture</p>
    <h2 id="security-posture-heading">Mechanisms, safeguards, and honest boundaries</h2>
    <p>
      Trust the cryptography, use the operational guards, and read the limits before you rely on deletion or memory handling claims.
    </p>
    <p class="security-posture__links">
      <a href={`${base}docs/security`}>Security Overview</a>
      <a href={`${base}docs/security/best-practices`}>Best Practices</a>
    </p>
  </div>
  <div class="security-posture__columns">
    {columns.map((column) => (
      <section class="security-posture__column" aria-labelledby={`security-${column.title.toLowerCase()}`}>
        <h3 id={`security-${column.title.toLowerCase()}`}>{column.title}</h3>
        <ul>
          {column.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</section>

<style>
  .security-posture {
    display: grid;
    gap: 32px;
  }

  .security-posture__intro p {
    max-width: 42rem;
    color: var(--text-muted);
  }

  .security-posture__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-bottom: 0;
  }

  .security-posture__links a {
    font-weight: 600;
    text-decoration: none;
  }

  .security-posture__links a:hover {
    text-decoration: underline;
  }

  .security-posture__columns {
    display: grid;
    gap: 24px;
  }

  .security-posture__column {
    border-top: 1px solid var(--border);
    padding-top: 16px;
  }

  .security-posture__column h3 {
    margin-bottom: 12px;
    font: 600 0.875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .security-posture__column ul {
    margin: 0;
    padding-inline-start: 1.1rem;
    color: var(--text-muted);
  }

  .security-posture__column li + li {
    margin-top: 8px;
  }

  @media (min-width: 1024px) {
    .security-posture {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 64px;
      align-items: start;
    }

    .security-posture__columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
  }
</style>
