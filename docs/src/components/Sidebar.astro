---
import { DOCS_NAV, SITE, normalizePath, withBase } from '../data/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const currentPath = normalizePath(Astro.url.pathname);
const currentHash = Astro.url.hash.replace(/^#/, '');

type NavItem = { title: string; href: string };

function itemParts(href: string) {
  const [pathPart = '', hashPart = ''] = href.split('#');
  return {
    path: normalizePath(pathPart),
    hash: hashPart,
    href: withBase(href, base),
  };
}

function isCurrent(item: NavItem, siblings: NavItem[]) {
  const { path, hash } = itemParts(item.href);
  if (currentPath !== path) return false;

  if (hash) {
    return currentHash === hash;
  }

  const moreSpecificHashMatch = siblings.some((sibling) => {
    if (sibling.href === item.href) return false;
    const parts = itemParts(sibling.href);
    return parts.path === currentPath && parts.hash && parts.hash === currentHash;
  });

  return !moreSpecificHashMatch;
}

function renderGroups() {
  return DOCS_NAV.map((section) => ({
    group: section.group,
    items: section.items.map((item) => {
      const parts = itemParts(item.href);
      return {
        title: item.title,
        href: parts.href,
        current: isCurrent(item, section.items as NavItem[]),
      };
    }),
  }));
}

const desktopGroups = renderGroups();
const mobileGroups = renderGroups();
---

<aside class="docs-sidebar" aria-label="Documentation">
  <nav class="docs-sidebar__nav" aria-label="Documentation sections">
    {desktopGroups.map((section) => (
      <div class="docs-nav-group">
        <h2 class="docs-nav-group__title">{section.group}</h2>
        <ul class="docs-nav-group__list">
          {section.items.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
  <p class="docs-sidebar__version">
    <span class="docs-sidebar__version-label">Version</span>
    <span class="docs-sidebar__version-number">{SITE.version}</span>
  </p>
</aside>

<details class="mobile-docs-nav" data-mobile-docs-nav>
  <summary class="mobile-docs-nav__summary">
    <span class="mobile-docs-nav__summary-label">Browse documentation</span>
    <button
      type="button"
      class="mobile-docs-nav__close"
      data-mobile-docs-close
      aria-label="Close documentation menu"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </summary>
  <div class="mobile-docs-nav__panel" data-mobile-docs-panel>
    <nav class="mobile-docs-nav__nav" aria-label="Documentation sections">
      {mobileGroups.map((section) => (
        <div class="docs-nav-group">
          <h2 class="docs-nav-group__title">{section.group}</h2>
          <ul class="docs-nav-group__list">
            {section.items.map((item) => (
              <li>
                <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <p class="docs-sidebar__version">
      <span class="docs-sidebar__version-label">Version</span>
      <span class="docs-sidebar__version-number">{SITE.version}</span>
    </p>
  </div>
</details>

<style>
  .docs-sidebar {
    display: none;
  }

  .docs-nav-group {
    margin-block: 0 24px;
  }

  .docs-nav-group__title {
    margin: 0 0 8px;
    color: var(--text-muted);
    font: 600 0.75rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .docs-nav-group__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .docs-nav-group__list a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .docs-nav-group__list a:hover {
    background: var(--surface-raised);
  }

  .docs-nav-group__list a[aria-current='page'] {
    background: color-mix(in srgb, var(--accent) 16%, var(--surface));
    color: var(--text);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  .docs-sidebar__version {
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .docs-sidebar__version-label {
    display: block;
    margin-bottom: 4px;
    font: 600 0.75rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .docs-sidebar__version-number {
    color: var(--text);
    font-family: var(--font-mono);
  }

  .mobile-docs-nav {
    display: block;
    margin-bottom: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .mobile-docs-nav > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    padding: 12px 16px;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }

  .mobile-docs-nav > summary::-webkit-details-marker {
    display: none;
  }

  .mobile-docs-nav__summary-label {
    min-width: 0;
  }

  .mobile-docs-nav__close {
    display: none;
    flex: 0 0 auto;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: -6px -8px -6px 0;
    border: 0;
    border-radius: var(--radius-sm);
    padding: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .mobile-docs-nav[open] .mobile-docs-nav__close {
    display: inline-grid;
  }

  .mobile-docs-nav__close:hover {
    background: var(--surface-raised);
  }

  .mobile-docs-nav__close:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .mobile-docs-nav__close svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .mobile-docs-nav__panel {
    padding: 0 16px 16px;
  }

  /* Backdrop is created at runtime; keep selectors global so Astro scoping still matches it. */
  :global(.mobile-docs-nav__backdrop) {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 60;
    margin: 0;
    border: 0;
    padding: 0;
    background: color-mix(in srgb, var(--canvas) 35%, transparent);
    cursor: pointer;
  }

  :global(.mobile-docs-nav__backdrop.is-visible) {
    display: block;
  }

  /*
    Open enhanced menu becomes a fixed drawer sized to the viewport.
    Avoid flex layout on <details> - browsers do not size its children
    reliably, which previously either clipped Project or collapsed the panel.
    Panel max-height is assigned in script from the drawer’s client box.
  */
  .mobile-docs-nav[data-enhanced='true'][open] {
    position: fixed;
    z-index: 61;
    top: max(12px, env(safe-area-inset-top, 0px));
    right: 16px;
    bottom: max(12px, env(safe-area-inset-bottom, 0px));
    left: 16px;
    display: block;
    margin: 0;
    overflow: hidden;
  }

  .mobile-docs-nav[data-enhanced='true'][open] > summary,
  .mobile-docs-nav[data-enhanced='true'][open] .mobile-docs-nav__panel {
    position: relative;
    z-index: 61;
    background: var(--surface);
  }

  .mobile-docs-nav[data-enhanced='true'][open] > summary {
    border-bottom: 1px solid var(--border);
  }

  .mobile-docs-nav[data-enhanced='true'][open] .mobile-docs-nav__panel {
    overflow-x: hidden;
    overflow-y: scroll;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-gutter: stable;
    padding-bottom: 28px;
    /* Always show a readable scrollbar so overflow is obvious on overlay-scrollbar OSes. */
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--accent) 70%, var(--border)) var(--surface-raised);
  }

  .mobile-docs-nav[data-enhanced='true'][open] .mobile-docs-nav__panel::-webkit-scrollbar {
    width: 10px;
  }

  .mobile-docs-nav[data-enhanced='true'][open] .mobile-docs-nav__panel::-webkit-scrollbar-track {
    background: var(--surface-raised);
  }

  .mobile-docs-nav[data-enhanced='true'][open] .mobile-docs-nav__panel::-webkit-scrollbar-thumb {
    border: 2px solid var(--surface-raised);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 70%, var(--border));
  }

  /*
    Bottom fade while more nav remains below the fold.
    Makes the hard clip read as “scroll for more” instead of a truncated menu.
  */
  .mobile-docs-nav[data-enhanced='true'][open][data-more-below='true']::after {
    content: '';
    position: absolute;
    z-index: 62;
    right: 12px;
    bottom: 0;
    left: 0;
    height: 56px;
    pointer-events: none;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    background: linear-gradient(to bottom, transparent, var(--surface) 72%);
  }

  @media (min-width: 1024px) {
    .docs-sidebar {
      display: block;
    }

    .mobile-docs-nav {
      display: none;
    }
  }
</style>

<script>
  const root = document.querySelector('[data-mobile-docs-nav]');
  if (root instanceof HTMLDetailsElement) {
    const summary = root.querySelector('summary');
    const panel = root.querySelector('[data-mobile-docs-panel]');
    const closeButton = root.querySelector('[data-mobile-docs-close]');
    root.dataset.enhanced = 'true';

    const backdrop = document.createElement('button');
    backdrop.type = 'button';
    backdrop.className = 'mobile-docs-nav__backdrop';
    backdrop.setAttribute('data-mobile-docs-backdrop', '');
    backdrop.setAttribute('aria-label', 'Close documentation menu');
    backdrop.tabIndex = -1;
    // Keep the backdrop outside <details> so it does not participate in the flex drawer layout.
    document.body.appendChild(backdrop);

    const syncBackdrop = () => {
      backdrop.classList.toggle('is-visible', root.open);
    };

    const syncMoreBelow = () => {
      if (!(panel instanceof HTMLElement) || !root.open) {
        root.removeAttribute('data-more-below');
        return;
      }
      const remaining = panel.scrollHeight - panel.clientHeight - panel.scrollTop;
      root.dataset.moreBelow = remaining > 8 ? 'true' : 'false';
    };

    const layoutOpenPanel = () => {
      if (!(panel instanceof HTMLElement) || !(summary instanceof HTMLElement)) return;
      if (!root.open) {
        panel.style.removeProperty('max-height');
        syncMoreBelow();
        return;
      }
      // Client height is definite once the drawer is fixed with top/bottom insets.
      const available = root.clientHeight - summary.offsetHeight;
      panel.style.maxHeight = `${Math.max(160, available)}px`;
      // Force layout so scroll metrics reflect the new max-height before the fade sync.
      void panel.offsetHeight;
      syncMoreBelow();
    };

    const getFocusable = () => {
      if (!(panel instanceof HTMLElement) || !summary) return [];
      const nodes: HTMLElement[] = [];
      if (closeButton instanceof HTMLElement) nodes.push(closeButton);
      nodes.push(
        ...panel.querySelectorAll<HTMLElement>('a, button, input, select, textarea, [tabindex]:not([tabindex="-1"])'),
      );
      return nodes.filter(
        (el) => !el.hasAttribute('disabled') && el.getAttribute('aria-hidden') !== 'true' && el !== backdrop,
      );
    };

    const unlock = () => {
      document.body.style.removeProperty('overflow');
    };

    const lock = () => {
      document.body.style.overflow = 'hidden';
    };

    const close = ({ restoreFocus = true }: { restoreFocus?: boolean } = {}) => {
      if (!root.open) return;
      root.open = false;
      syncBackdrop();
      layoutOpenPanel();
      unlock();
      if (restoreFocus && summary instanceof HTMLElement) summary.focus();
    };

    syncBackdrop();

    root.addEventListener('toggle', () => {
      syncBackdrop();
      layoutOpenPanel();
      if (root.open) {
        lock();
        queueMicrotask(() => {
          layoutOpenPanel();
          requestAnimationFrame(() => {
            layoutOpenPanel();
            const focusable = getFocusable();
            focusable[1]?.focus();
          });
        });
      } else {
        unlock();
      }
    });

    window.addEventListener('resize', () => {
      if (root.open) layoutOpenPanel();
    });

    if (panel instanceof HTMLElement) {
      panel.addEventListener('scroll', syncMoreBelow, { passive: true });
    }

    root.addEventListener('keydown', (event) => {
      if (!root.open) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }

      if (event.key !== 'Tab') return;
      const focusable = getFocusable();
      if (focusable.length === 0) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && active === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    });

    backdrop.addEventListener('click', () => {
      close();
    });

    if (closeButton instanceof HTMLButtonElement) {
      closeButton.addEventListener('click', (event) => {
        // Keep summary from toggling open again while we close explicitly.
        event.preventDefault();
        event.stopPropagation();
        close();
      });
    }

    root.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('a')) close({ restoreFocus: false });
    });

    document.addEventListener('click', (event) => {
      if (!root.open || !(event.target instanceof Node)) return;
      if (!root.contains(event.target)) close();
    });
  }
</script>
