---
const transcript = `PS> nokvault encrypt .\\archive
✓ Encryption completed successfully

PS> nokvault decrypt .\\archive.nokv
✓ Decryption completed successfully`;
---

<figure class="terminal-demo" aria-label="NokVault encrypt and decrypt demonstration">
  <figcaption class="terminal-demo__caption">
    <span class="terminal-demo__dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
    <span>Quick start</span>
  </figcaption>
  <pre class="terminal-demo__body" tabindex="0"><code>{transcript}</code></pre>
</figure>

<style>
  .terminal-demo {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--code-canvas);
    overflow: hidden;
  }

  .terminal-demo__caption {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--border);
    padding: 10px 14px;
    color: var(--text-muted);
    font: 600 0.75rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .terminal-demo__dots {
    display: inline-flex;
    gap: 6px;
  }

  .terminal-demo__dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
  }

  .terminal-demo__body {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 18px 16px 20px;
    overflow-x: auto;
    color: var(--text);
  }

  .terminal-demo__body code {
    white-space: pre;
  }
</style>
