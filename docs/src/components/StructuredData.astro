---
import { SITE } from '../data/site';

export interface Props {
  type: 'SoftwareApplication' | 'BreadcrumbList' | 'WebSite';
  data?: any;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const { type, data, breadcrumbs } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const siteUrl = SITE.url;

let schema = {};

if (type === 'SoftwareApplication' && data) {
  const {
    aggregateRating: _aggregateRating,
    rating: _rating,
    potentialAction: _potentialAction,
    ...applicationData
  } = data;

  schema = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: applicationData.name || SITE.name,
    applicationCategory: 'SecurityApplication',
    operatingSystem: 'Windows, Linux, macOS',
    description: applicationData.description || SITE.description,
    url: `${siteUrl}${base}`,
    downloadUrl: applicationData.downloadUrl || SITE.releases,
    softwareVersion: applicationData.version || SITE.version,
    releaseNotes: `${siteUrl}${base}docs/changelog`,
    license: 'https://opensource.org/licenses/MIT',
    author: {
      '@type': 'Person',
      name: 'jimididit',
      url: 'https://github.com/jimididit'
    },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD'
    },
    ...applicationData
  };
} else if (type === 'BreadcrumbList' && breadcrumbs) {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: crumb.url.startsWith('http') ? crumb.url : `${siteUrl}${crumb.url}`
    }))
  };
} else if (type === 'WebSite') {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    description: SITE.description,
    url: `${siteUrl}${base}`,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl}${base}docs/?q={search_term_string}`
      },
      'query-input': 'required name=search_term_string'
    }
  };
}

const cleanSchema = JSON.parse(JSON.stringify(schema, (_key, value) => value === undefined ? undefined : value));
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(cleanSchema)} />
